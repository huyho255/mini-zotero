<UserControl
    x:Class="MiniZotero.Views.TabWorkspaceView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:MiniZotero.Views"
    xmlns:vm="using:MiniZotero.ViewModels"
    x:DataType="vm:TabWorkspaceViewModel">

	<Grid RowDefinitions="44,*" Background="#0B1120">

		<!-- Empty tab bar -->
		<Border Grid.Row="0" Background="#111827">
			<Grid ColumnDefinitions="Auto,*,Auto" Margin="10,0">
				<Button Grid.Column="0"
                        Content="+"
                        Width="34"
                        Height="30"
                        VerticalAlignment="Center"
                        FontSize="15"/>

				<TextBlock Grid.Column="1"
                           Text="{Binding CurrentTabTitle}"
                           VerticalAlignment="Center"
                           Foreground="#64748B"
                           FontSize="13"
                           Margin="12,0,0,0"/>

				<StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Spacing="12">
					<TextBlock Text="{Binding SearchHint}"
                               Foreground="#64748B"
                               FontSize="12"/>

					<TextBlock Text="⋯"
                               Foreground="#94A3B8"
                               FontSize="16"/>
				</StackPanel>
			</Grid>
		</Border>

		<!-- Workspace content -->
		<views:PdfViewerView Grid.Row="1"
                             DataContext="{Binding PdfViewer}"/>
	</Grid>
</UserControl>
