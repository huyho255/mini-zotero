<UserControl
    x:Class="MiniZotero.Views.SidebarView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MiniZotero.ViewModels"
    xmlns:models="using:MiniZotero.Models"
    x:DataType="vm:SidebarViewModel">

	<Border Background="#0F172A" Padding="12">
		<Grid RowDefinitions="Auto,Auto,*,Auto">

			<!-- App title -->
			<Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,4,0,18">
				<Border Grid.Column="0"
                        Width="26"
                        Height="26"
                        CornerRadius="7"
                        Background="#7C3AED">
					<TextBlock Text="M"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="White"
                               FontSize="13"
                               FontWeight="SemiBold"/>
				</Border>

				<TextBlock Grid.Column="1"
                           Text="MiniZotero"
                           VerticalAlignment="Center"
                           Margin="10,0,0,0"
                           Foreground="#F8FAFC"
                           FontSize="14"
                           FontWeight="SemiBold"/>

				<TextBlock Grid.Column="2"
                           Text="⚙"
                           VerticalAlignment="Center"
                           Foreground="#94A3B8"
                           FontSize="13"/>
			</Grid>

			<!-- Search -->
			<TextBox Grid.Row="1"
                     Height="34"
                     PlaceholderText="Search documents..."
                     Text="{Binding SearchText}"
                     FontSize="13"
                     Background="#111827"
                     Foreground="#E5E7EB"
                     BorderBrush="#334155"
                     BorderThickness="1"
                     Padding="10,0"/>

			<!-- Library area -->
			<Grid Grid.Row="2"
                  RowDefinitions="Auto,Auto,*"
                  Margin="0,18,0,0">

				<!-- Library title -->
				<Grid Grid.Row="0" ColumnDefinitions="*,Auto">
					<TextBlock Text="LIBRARY"
                               Foreground="#94A3B8"
                               FontSize="11"
                               FontWeight="SemiBold"/>

					<Button Grid.Column="1"
                            Content="+"
                            Width="26"
                            Height="24"
                            FontSize="14"/>
				</Grid>

				<!-- Menu -->
				<StackPanel Grid.Row="1" Margin="0,10,0,0" Spacing="4">
					<Border Background="#1E293B" CornerRadius="6" Padding="10,8">
						<TextBlock Text="All Documents"
                                   Foreground="#F8FAFC"
                                   FontSize="13"
                                   FontWeight="SemiBold"/>
					</Border>

					<Border CornerRadius="6" Padding="10,8">
						<TextBlock Text="Recent"
                                   Foreground="#CBD5E1"
                                   FontSize="13"/>
					</Border>

					<Border CornerRadius="6" Padding="10,8">
						<TextBlock Text="Starred"
                                   Foreground="#CBD5E1"
                                   FontSize="13"/>
					</Border>

					<Border CornerRadius="6" Padding="10,8">
						<TextBlock Text="Trash"
                                   Foreground="#CBD5E1"
                                   FontSize="13"/>
					</Border>
				</StackPanel>

				<!-- Document list + empty state -->
				<Grid Grid.Row="2" Margin="0,16,0,0">

					<Border Background="#111827"
                            CornerRadius="8"
                            BorderBrush="#1E293B"
                            BorderThickness="1">
						<ListBox ItemsSource="{Binding Documents}"
                                 SelectedItem="{Binding SelectedDocument, Mode=TwoWay}"
                                 IsVisible="{Binding HasDocuments}"
                                 Background="Transparent"
                                 BorderThickness="0">
							<ListBox.ItemTemplate>
								<DataTemplate x:DataType="models:DocumentItem">
									<Border Padding="8" CornerRadius="6">
										<StackPanel>
											<TextBlock Text="{Binding Title}"
                                                       Foreground="#E5E7EB"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"/>

											<TextBlock Text="{Binding FilePath}"
                                                       Foreground="#64748B"
                                                       FontSize="11"/>
										</StackPanel>
									</Border>
								</DataTemplate>
							</ListBox.ItemTemplate>
						</ListBox>
					</Border>

					<!-- Empty state -->
					<Border Background="#111827"
                            CornerRadius="8"
                            BorderBrush="#1E293B"
                            BorderThickness="1"
                            Padding="12"
                            IsVisible="{Binding IsDocumentListEmpty}">
						<StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="8">
							<TextBlock Text="{Binding EmptyTitle}"
                                       Foreground="#94A3B8"
                                       FontSize="13"
                                       HorizontalAlignment="Center"/>

							<TextBlock Text="{Binding EmptyMessage}"
                                       Foreground="#64748B"
                                       FontSize="12"
                                       HorizontalAlignment="Center"/>
						</StackPanel>
					</Border>

				</Grid>
			</Grid>

			<!-- Import button -->
			<Button Grid.Row="3"
                    Content="+ Import PDF"
                    Height="36"
                    Margin="0,12,0,0"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Padding="12,0"
                    Click="OnImportPdfClicked"/>

		</Grid>
	</Border>
</UserControl>
