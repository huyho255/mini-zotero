<Window
    x:Class="MiniZotero.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:MiniZotero.Views"
    xmlns:vm="using:MiniZotero.ViewModels"
    x:DataType="vm:MainWindowViewModel"
    Title="MiniZotero - Document Manager"
    Width="1280"
    Height="760"
    MinWidth="1000"
    MinHeight="600"
    FontFamily="Segoe UI"
    FontWeight="Normal"
    Background="#0B1120">

	<Grid RowDefinitions="36,*">

		<!-- Top menu -->
		<Border Grid.Row="0" Background="#030712">
			<Grid ColumnDefinitions="Auto,*,Auto">
				<StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Spacing="20"
                            Margin="10,0">
					<TextBlock Text="File" Foreground="#E5E7EB" FontSize="13"/>
					<TextBlock Text="Edit" Foreground="#E5E7EB" FontSize="13"/>
					<TextBlock Text="View" Foreground="#E5E7EB" FontSize="13"/>
					<TextBlock Text="Help" Foreground="#E5E7EB" FontSize="13"/>
				</StackPanel>

				<TextBlock Grid.Column="1"
                           Text="{Binding AppTitle}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="#E5E7EB"
                           FontSize="13"
                           FontWeight="SemiBold"/>
			</Grid>
		</Border>

		<!-- Main layout -->
		<Grid Grid.Row="1">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="250"/>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="380"/>
			</Grid.ColumnDefinitions>

			<views:SidebarView Grid.Column="0"
                               DataContext="{Binding Sidebar}"/>

			<views:TabWorkspaceView Grid.Column="1"
                                    DataContext="{Binding Workspace}"/>

			<views:NotePreviewPanelView Grid.Column="2"
                                        DataContext="{Binding NotePanel}"/>
		</Grid>
	</Grid>
</Window>