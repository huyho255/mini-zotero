<UserControl
    x:Class="MiniZotero.Views.PdfViewerView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MiniZotero.ViewModels"
    x:DataType="vm:PdfViewerViewModel">

    <Border Background="#F3F4F6" Padding="12">
        <Grid RowDefinitions="42,*,34">

            <!-- Toolbar -->
            <Border Grid.Row="0"
                    Background="White"
                    CornerRadius="8,8,0,0"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    Padding="10,0">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <TextBlock Grid.Column="0"
                               Text="{Binding StatusText}"
                               VerticalAlignment="Center"
                               Foreground="#64748B"
                               FontSize="12"/>

                    <TextBlock Grid.Column="2"
                               Text="PDF.js Viewer"
                               VerticalAlignment="Center"
                               Foreground="#111827"
                               FontSize="13"
                               FontWeight="SemiBold"/>
                </Grid>
            </Border>

            <!-- PDF.js WebView area -->
            <Grid Grid.Row="1" Background="White">

                <NativeWebView Source="{Binding ViewerSource}"
                               IsVisible="{Binding HasDocumentLoaded}"/>

                <Border Background="White"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1,0,1,0"
                        IsVisible="{Binding IsEmptyViewVisible}">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="10">
                        <TextBlock Text="PDF"
                                   HorizontalAlignment="Center"
                                   FontSize="28"
                                   FontWeight="SemiBold"
                                   Foreground="#94A3B8"/>

                        <TextBlock Text="{Binding EmptyTitle}"
                                   HorizontalAlignment="Center"
                                   Foreground="#334155"
                                   FontSize="17"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="{Binding EmptyMessage}"
                                   HorizontalAlignment="Center"
                                   Foreground="#64748B"
                                   FontSize="13"/>
                    </StackPanel>
                </Border>

            </Grid>

            <!-- Bottom status -->
            <Border Grid.Row="2"
                    Background="White"
                    CornerRadius="0,0,8,8"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1">
                <Grid ColumnDefinitions="Auto,*,Auto" Margin="10,0">
                    <TextBlock Grid.Column="0"
                               Text="{Binding StatusText}"
                               VerticalAlignment="Center"
                               Foreground="#64748B"
                               FontSize="12"/>

                    <TextBlock Grid.Column="2"
                               Text="{Binding DocumentStatus}"
                               VerticalAlignment="Center"
                               Foreground="#94A3B8"
                               FontSize="12"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
